# Copy this file to `keystore.properties` (same directory) and fill in real
# values. The real file is gitignored. Do NOT commit secrets.
#
# Generate the upload keystore once with:
#   keytool -genkey -v \
#     -keystore keystore/thalock-upload.jks \
#     -alias thalock-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then upload the public certificate to Play Console (App signing → Upload key
# certificate) and let Play hold the actual app signing key.

storeFile=keystore/thalock-upload.jks
storePassword=CHANGEME
keyAlias=thalock-upload
keyPassword=CHANGEME
